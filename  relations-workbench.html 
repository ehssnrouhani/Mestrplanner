function renderLine(){
  const svg = $('#lineChart');
  const legend = $('#lineLegend');
  if(!DATA){ svg.innerHTML = ''; legend.innerHTML = ''; return; }

  const nodes = DATA.nodes;
  const n = nodes[0].values.length;
  const W = 980, H = 460;
  const P = {l:58, r:24, t:26, b:52};

  const visible = nodes.filter(nd => S.visible.has(nd.id));
  legend.innerHTML = nodes.map((nd,i)=>{
    const color = PALETTE[i%PALETTE.length];
    const on = S.visible.has(nd.id);
    return `<span class="legend-item ${on?'':'off'}" data-toggle="${nd.id}">
      <span class="legend-dot" style="background:${color}"></span>${nd.name}</span>`;
  }).join('');

  if(!visible.length){
    svg.innerHTML = `<text x="${W/2}" y="${H/2}" class="axis-label" text-anchor="middle">همهٔ سری‌ها پنهان‌اند. از برچسب‌ها یکی را فعال کنید.</text>`;
    return;
  }

  const allVals = visible.flatMap(nd=>nd.values);
  let yMin = Math.min(...allVals), yMax = Math.max(...allVals);
  const pad = (yMax-yMin)*0.08 || 1;
  yMin -= pad; yMax += pad;

  const xS = i => P.l + (i/(n-1)) * (W-P.l-P.r);
  const yS = v => H-P.b - ((v-yMin)/(yMax-yMin)) * (H-P.t-P.b);

  const parts = [];

  const ticks = 5;
  for(let t=0;t<=ticks;t++){
    const v = yMin + (yMax-yMin)*t/ticks;
    const y = yS(v);
    parts.push(`<line class="grid-line" x1="${P.l}" x2="${W-P.r}" y1="${y}" y2="${y}"/>`);
    parts.push(`<text class="axis-label" x="${P.l-10}" y="${y+4}" text-anchor="end">${fa(v,1)}</text>`);
  }
  for(let i=0;i<n;i++){
    parts.push(`<text class="axis-label" x="${xS(i)}" y="${H-P.b+20}" text-anchor="middle">${fa(i+1,0)}</text>`);
  }
  parts.push(`<line class="axis-line" x1="${P.l}" x2="${W-P.r}" y1="${H-P.b}" y2="${H-P.b}"/>`);
  parts.push(`<line class="axis-line" x1="${P.l}" x2="${P.l}" y1="${P.t}" y2="${H-P.b}"/>`);
  parts.push(`<text class="axis-label" x="${W/2}" y="${H-10}" text-anchor="middle">${DATA.xLabel||'گام'}</text>`);

  visible.forEach(nd=>{
    const idx = nodes.indexOf(nd);
    const color = PALETTE[idx%PALETTE.length];
    let d = '';
    nd.values.forEach((v,i)=>{ d += (i?'L':'M') + xS(i) + ',' + yS(v) + ' '; });
    parts.push(`<path d="${d}" fill="none" stroke="${color}" stroke-width="2.2" stroke-linejoin="round"/>`);
    nd.values.forEach((v,i)=>{
      parts.push(`<circle cx="${xS(i)}" cy="${yS(v)}" r="3.3" fill="${color}" stroke="var(--panel)" stroke-width="1.4"/>`);
    });
    const st = computed.nodeStats[nd.id];
    if(st){
      parts.push(`<circle cx="${xS(st.maxIdx)}" cy="${yS(st.max)}" r="6" fill="none" stroke="${color}" stroke-width="2" opacity=".55"/>`);
      parts.push(`<circle cx="${xS(st.minIdx)}" cy="${yS(st.min)}" r="6" fill="none" stroke="${color}" stroke-width="2" opacity=".55"/>`);
    }
  });

  svg.innerHTML = parts.join('');
}

