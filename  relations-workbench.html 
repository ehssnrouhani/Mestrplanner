/* =========================================================
   ۵) اعتبارسنجی
   ========================================================= */
function validate(o){
  if(!o || typeof o!=='object') return {ok:false, err:'داده باید یک شیء باشد.'};
  if(!Array.isArray(o.nodes) || o.nodes.length<2) return {ok:false, err:'حداقل دو متغیر (node) لازم است.'};
  const n = o.nodes[0]?.values?.length;
  if(!n || n<4) return {ok:false, err:'هر متغیر حداقل ۴ مقدار لازم دارد.'};
  const ids = new Set();
  for(const nd of o.nodes){
    if(!nd.id || typeof nd.id!=='string') return {ok:false, err:'هر متغیر باید id داشته باشد.'};
    if(ids.has(nd.id)) return {ok:false, err:`id تکراری: ${nd.id}`};
    ids.add(nd.id);
    if(!nd.name) return {ok:false, err:`متغیر ${nd.id}: نام لازم است.`};
    if(!Array.isArray(nd.values) || nd.values.length!==n) return {ok:false, err:`متغیر ${nd.name}: تعداد مقادیر باید ${n} باشد.`};
    for(const v of nd.values) if(!isFinite(v)) return {ok:false, err:`متغیر ${nd.name}: مقدار نامعتبر (${v}).`};
  }
  if(!Array.isArray(o.edges)) o.edges = [];
  for(const e of o.edges){
    if(!ids.has(e.from) || !ids.has(e.to)) return {ok:false, err:`یال نامعتبر: ${e.from} → ${e.to}`};
    if(e.sign !== 1 && e.sign !== -1) return {ok:false, err:'علامت یال باید +1 یا -1 باشد.'};
  }
  return {ok:true};
}

/* =========================================================
   ۶) تحلیل
   ========================================================= */
function analyze(){
  if(!DATA) return;
  const nodes = DATA.nodes;
  const n = nodes[0].values.length;
  const edges = DATA.edges || [];

  const nodeStats = {};
  nodes.forEach(nd=>{
    const v = nd.values;
    const max = Math.max(...v), min = Math.min(...v);
    nodeStats[nd.id] = {
      mean: M.mean(v), stdev: M.stdev(v),
      max, min, maxIdx: v.indexOf(max), minIdx: v.indexOf(min),
      range: max-min
    };
  });

  const pairs = [];
  for(let i=0;i<nodes.length;i++){
    for(let j=i+1;j<nodes.length;j++){
      const A = nodes[i], B = nodes[j];
      const x = A.values, y = B.values;
      const r = M.pearson(x,y);
      const rho = M.spearman(x,y);
      const lin = M.linreg(x,y);
      const quad = M.quadreg(x,y);
      const half = M.halfSplit(x,y);
      const thr = M.xThreshold(x,y);
      const lag = M.lagCorr(x,y,3);
      const edge = edges.find(e =>
        (e.from===A.id && e.to===B.id) || (e.from===B.id && e.to===A.id));
      pairs.push({a:A.id, b:B.id, r, rho, lin, quad, half, thr, lag, edge});
    }
  }

  const corr = nodes.map((a)=>nodes.map((b)=> a.id===b.id?1:M.pearson(a.values,b.values)));
  const corrS = nodes.map((a)=>nodes.map((b)=> a.id===b.id?1:M.spearman(a.values,b.values)));

  const cycles = findCycles(nodes, edges);
  const clusters = cluster(nodes, corr, S.clusterThreshold);

  computed = {nodes, edges, pairs, corr, corrS, cycles, clusters, nodeStats, n};
}

function findEdge(edges, a, b){
  return edges.find(e => (e.from===a && e.to===b) || (e.from===b && e.to===a));
}

function findCycles(nodes, edges){
  const adj = {};
  nodes.forEach(n=>adj[n.id]=[]);
  edges.forEach(e=>{ if(adj[e.from]) adj[e.from].push({to:e.to, sign:e.sign, lag:e.lag||0}); });
  const cycles = [];
  const seen = new Set();
  function dfs(start, cur, path, signs, lags, visited){
    for(const nxt of adj[cur]||[]){
      if(nxt.to===start && path.length>=2){
        const cycleKey = [...path].sort().join('|') + ':' + path.length;
        if(!seen.has(cycleKey)){
          seen.add(cycleKey);
          const allSigns = [...signs, nxt.sign];
          const negCount = allSigns.filter(s=>s<0).length;
          cycles.push({
            nodes:[...path],
            signs: allSigns,
            lags: [...lags, nxt.lag],
            type: negCount % 2 === 0 ? 'reinforcing' : 'balancing',
            totalLag: [...lags, nxt.lag].reduce((s,v)=>s+v,0)
          });
        }
      } else if(!visited.has(nxt.to) && path.length < nodes.length){
        visited.add(nxt.to); path.push(nxt.to); signs.push(nxt.sign); lags.push(nxt.lag||0);
        dfs(start, nxt.to, path, signs, lags, visited);
        path.pop(); signs.pop(); lags.pop(); visited.delete(nxt.to);
      }
    }
  }
  nodes.forEach(n=>dfs(n.id, n.id, [n.id], [], [], new Set([n.id])));
  return cycles;
}

function cluster(nodes, corr, threshold){
  const n = nodes.length;
  let clusters = nodes.map((_,i)=>({members:[i]}));
  const dist = (i,j) => 1 - corr[i][j];
  let guard = 0;
  while(clusters.length > 1 && guard++ < 100){
    let best = null;
    for(let a=0;a<clusters.length;a++){
      for(let b=a+1;b<clusters.length;b++){
        let sum=0, cnt=0;
        for(const i of clusters[a].members) for(const j of clusters[b].members){ sum+=dist(i,j); cnt++; }
        const d = sum/cnt;
        if(!best || d < best.d) best = {a,b,d};
      }
    }
    if(!best || best.d > threshold) break;
    const merged = {members:[...clusters[best.a].members, ...clusters[best.b].members]};
    clusters = clusters.filter((_,i)=> i!==best.a && i!==best.b);
    clusters.push(merged);
  }
  return clusters;
}

/* =========================================================
   ۷) طبقه‌بندی جفت
   ========================================================= */
function classifyPair(p){
  const tags = [];
  const r = p.r, rho = p.rho;
  if(isNaN(r)){ tags.push({t:'داده ناکافی', c:'none'}); return tags; }
  const absR = Math.abs(r);

  if(absR >= 0.7) tags.push({t: r>0?'مستقیم قوی':'معکوس قوی', c:'strong'});
  else if(absR >= 0.4) tags.push({t: r>0?'مستقیم متوسط':'معکوس متوسط', c:'med'});
  else if(absR >= 0.2) tags.push({t: r>0?'مستقیم ضعیف':'معکوس ضعیف', c:'weak'});
  else tags.push({t:'بی‌ارتباط', c:'none'});

  const gainQ = p.quad.r2 - p.lin.r2;
  if(gainQ > 0.12) tags.push({t:'غیرخطی (درجه۲)', c:'nl'});
  if(!isNaN(rho) && Math.abs(rho) - absR > 0.2) tags.push({t:'غیرخطی یکنوا', c:'nl'});

  if(p.thr && p.thr.gain > 0.12){
    tags.push({t:`آستانه در ${fmt(p.thr.threshold)}`, c:'thr'});
    if(p.thr.signFlip) tags.push({t:'تغییر علامت شیب', c:'flip'});
  }

  if(p.half.flip) tags.push({t:'متناقض (تغییر رژیم)', c:'par'});

  if(p.edge){
    if(p.edge.sign !== Math.sign(r) && Math.abs(r) > 0.15) tags.push({t:'مغایر با فرض علّی', c:'par'});
    else if(p.edge.sign === Math.sign(r)) tags.push({t:'هم‌راستا با فرض', c:'ok'});
  }

  return tags;
}

