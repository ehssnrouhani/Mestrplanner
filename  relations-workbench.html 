/* =========================================================
   ۴) وضعیت
   ========================================================= */
const LS_KEY = 'relational-workbench-v1';
let DATA = null;
let computed = null;
let S = {theme:'dark', visible:new Set(), selectedPairs:[], activePair:null, tableMode:'corr', clusterThreshold:0.5};

function save(){
