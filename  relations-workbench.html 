    if(isNaN(r)) return 'transparent';
    const t = Math.max(-1, Math.min(1, r));
    const mid = dark ? [30,41,54] : [241,245,249];
    const pos = [59,130,246], neg = [220,38,38];
    const target = t>=0 ? pos : neg;
    const u = Math.abs(t);
    const c = mid.map((m,i)=> Math.round(m + (target[i]-m)*u));
    return `rgb(${c.join(',')})`;
  };

  let html = '<table class="heatmap"><thead><tr><th></th>' +
    orderedNodes.map(nd=>`<th style="writing-mode:vertical-rl;transform:rotate(180deg);padding:8px 2px">${nd.name}</th>`).join('') + '</tr></thead><tbody>';
