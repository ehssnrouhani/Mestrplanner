<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f2f5f9; --panel:#fff; --ink:#15202b; --muted:#64748b;
  --line:#d9e1ea; --line-strong:#b8c4d3; --head:#edf2f8;
  --accent:#2563eb; --accent-soft:#e8f0fe;
  --pos:#059669; --neg:#dc2626; --purple:#7c3aed; --amber:#d97706;
  --radius:12px; --shadow:0 1px 2px rgba(16,24,40,.06),0 8px 24px rgba(16,24,40,.06);
}
[data-theme="dark"]{
  --bg:#0f172a; --panel:#1e293b; --ink:#f1f5f9; --muted:#94a3b8;
  --line:#334155; --line-strong:#475569; --head:#162033;
  --accent:#e8971f; --accent-soft:rgba(232,151,31,.14);
  --pos:#34d399; --neg:#f87171; --purple:#a78bfa; --amber:#fbbf24;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:'Vazirmatn',Tahoma,'Segoe UI',system-ui,sans-serif;
  font-size:14px;line-height:1.85}
h1,h2,h3,h4{margin:0;font-weight:700;line-height:1.5}
button,select,input,textarea{font-family:inherit;font-size:inherit;color:inherit}
button{cursor:pointer}
code{font-family:Consolas,monospace;background:var(--head);padding:1px 6px;border-radius:5px;font-size:12px}

/* ---- topbar ---- */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:12px 20px;background:var(--panel);border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:50;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:12px}
.logo{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;font-weight:700;font-size:18px}
.brand h1{font-size:16px}
.brand p{margin:0;font-size:12px;color:var(--muted)}
.top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.badge{font-size:11px;padding:4px 10px;border-radius:999px;border:1px solid var(--line-strong);
  color:var(--muted);background:var(--bg);white-space:nowrap}
.btn{border:1px solid var(--line-strong);background:var(--panel);color:var(--ink);
  padding:7px 14px;border-radius:9px;font-size:13px;transition:.15s;white-space:nowrap}
.btn:hover{background:var(--accent-soft);border-color:var(--accent)}
.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn.primary:hover{filter:brightness(1.08)}
.btn.ghost{background:transparent}
.btn.sm{padding:4px 10px;font-size:12px;border-radius:8px}
.btn.danger:hover{background:#fee2e2;border-color:var(--neg);color:var(--neg)}
[data-theme="dark"] .btn.danger:hover{background:#3b1212}

/* ---- tabs ---- */
.tabs{display:flex;gap:2px;padding:0 20px;background:var(--panel);
  border-bottom:1px solid var(--line);position:sticky;top:63px;z-index:49;
  overflow-x:auto;scrollbar-width:thin}
.tab-btn{border:0;background:transparent;padding:11px 15px;border-bottom:2px solid transparent;
  color:var(--muted);font-weight:600;font-size:12.5px;white-space:nowrap}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent)}
.tab-btn:hover{color:var(--ink)}

main{padding:16px 20px 60px;max-width:1600px;margin:0 auto}
.tab-panel{display:none}
.tab-panel.active{display:block;animation:fade .2s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}

/* ---- cards ---- */
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
  padding:16px 18px;box-shadow:var(--shadow);margin-bottom:14px}
.card h2{font-size:15px;margin-bottom:8px}
.card h3{font-size:13.5px;color:var(--accent);margin:14px 0 6px}
.card p{margin:6px 0}
.muted{color:var(--muted);font-size:12.5px}

/* ---- toolbar ---- */
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:8px 0 12px}
.search{flex:1 1 220px;position:relative}
.search input{width:100%;padding:8px 34px 8px 12px;border:1px solid var(--line-strong);
  border-radius:9px;background:var(--panel);outline:none}
.search input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
.search::before{content:"⌕";position:absolute;right:11px;top:50%;transform:translateY(-50%);
  color:var(--muted);font-size:16px;pointer-events:none}
select.filter{padding:8px 10px;border:1px solid var(--line-strong);border-radius:9px;background:var(--panel)}

/* ---- layout helpers ---- */
.split{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:14px;align-items:start}
.split-3{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) 300px;gap:14px;align-items:start}
@media(max-width:1100px){.split,.split-3{grid-template-columns:1fr}}
.panel-box{background:var(--panel);border:1px solid var(--line-strong);border-radius:var(--radius);
  padding:14px;box-shadow:var(--shadow)}
.panel-box h3{font-size:13px;margin-bottom:10px;display:flex;align-items:center;justify-content:space-between}

/* ---- SVG ---- */
svg{display:block;width:100%;height:auto;direction:ltr}
.chart-wrap{background:var(--panel);border:1px solid var(--line-strong);border-radius:var(--radius);
  padding:12px;box-shadow:var(--shadow);overflow:hidden}
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;font-size:12px}
.legend-item{display:inline-flex;align-items:center;gap:6px;cursor:pointer;padding:3px 8px;
  border-radius:7px;border:1px solid var(--line)}
.legend-item.off{opacity:.35;text-decoration:line-through}
.legend-dot{width:11px;height:11px;border-radius:50%;display:inline-block}

.axis-label{font-size:10.5px;fill:var(--muted);font-family:'Vazirmatn',sans-serif}
.grid-line{stroke:var(--line);stroke-width:1}
.axis-line{stroke:var(--line-strong);stroke-width:1.2}
.edge-label{font-size:10.5px;fill:var(--muted);font-family:Consolas,monospace;text-anchor:middle}
.node-label{font-size:11px;fill:var(--ink);font-family:'Vazirmatn',sans-serif;font-weight:600;text-anchor:middle}
.node-sub{font-size:9.5px;fill:var(--muted);font-family:'Vazirmatn',sans-serif;text-anchor:middle}

/* ---- table ---- */
.table-wrap{background:var(--panel);border:1px solid var(--line-strong);border-radius:var(--radius);
  overflow:auto;box-shadow:var(--shadow)}
table.grid{width:100%;border-collapse:separate;border-spacing:0;font-size:12.5px;min-width:640px}
table.grid thead th{position:sticky;top:0;z-index:3;background:var(--head);color:var(--muted);
  font-weight:600;font-size:11.5px;text-align:right;padding:8px;border-bottom:2px solid var(--line-strong);white-space:nowrap}
table.grid td{padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:middle}
table.grid tbody tr:hover>td{background:var(--accent-soft)}
.num{font-family:Consolas,monospace;font-size:11.5px;text-align:center;white-space:nowrap}
.mono{font-family:Consolas,monospace}

/* ---- chips ---- */
.chip{display:inline-block;font-size:10.5px;padding:1px 8px;border-radius:999px;
  background:var(--bg);border:1px solid var(--line);color:var(--muted);margin:1px 2px;white-space:nowrap}
.chip.strong{background:#dcfce7;color:#166534;border-color:#86efac}
.chip.med{background:#dbeafe;color:#1e40af;border-color:#93c5fd}
.chip.weak{background:#f1f5f9;color:#475569;border-color:#cbd5e1}
.chip.none{background:#f3f4f6;color:#6b7280;border-color:#d1d5db}
.chip.nl{background:#ede9fe;color:#5b21b6;border-color:#c4b5fd}
.chip.thr{background:#fef3c7;color:#92400e;border-color:#fcd34d}
.chip.flip{background:#fee2e2;color:#991b1b;border-color:#fca5a5}
.chip.par{background:#fce7f3;color:#9d174d;border-color:#f9a8d4}
.chip.ok{background:#d1fae5;color:#065f46;border-color:#6ee7b7}
[data-theme="dark"] .chip.strong{background:#0d3320;color:#6ee7a8;border-color:#1d6b45}
[data-theme="dark"] .chip.med{background:#0c1f3a;color:#93c5fd;border-color:#1e3a8a}
[data-theme="dark"] .chip.nl{background:#1e1b3a;color:#c4b5fd;border-color:#4c1d95}
[data-theme="dark"] .chip.thr{background:#3a2a09;color:#fbbf24;border-color:#7a5a12}
[data-theme="dark"] .chip.flip{background:#3b1212;color:#fca5a5;border-color:#7f1d1d}
[data-theme="dark"] .chip.par{background:#3b0a25;color:#f9a8d4;border-color:#831843}
[data-theme="dark"] .chip.ok{background:#052e1c;color:#6ee7b7;border-color:#065f46}

/* ---- heatmap ---- */
.heatmap-wrap{overflow:auto;background:var(--panel);border:1px solid var(--line-strong);
  border-radius:var(--radius);box-shadow:var(--shadow);padding:8px}
table.heatmap{border-collapse:collapse;font-size:11px;margin:0 auto}
table.heatmap th{padding:5px 7px;font-weight:600;font-size:10.5px;color:var(--muted);white-space:nowrap}
table.heatmap th.rowh{text-align:right;padding-right:10px}
table.heatmap td{padding:0;width:44px;height:34px;text-align:center;font-family:Consolas,monospace;
  font-size:10px;border:1px solid var(--panel);transition:.15s}
table.heatmap td:hover{outline:2px solid var(--accent);outline-offset:-2px}

/* ---- mini scatter grid ---- */
.mini-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.mini-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
  padding:10px;box-shadow:var(--shadow)}
.mini-card h4{font-size:12px;margin-bottom:4px}
.mini-card .stats{display:flex;gap:8px;flex-wrap:wrap;font-size:10.5px;color:var(--muted);margin-top:4px}
.mini-card .stats b{color:var(--ink);font-family:Consolas,monospace}

/* ---- compare bars ---- */
.bar-compare{display:grid;gap:6px;margin-top:8px}
.bar-row{display:grid;grid-template-columns:180px 1fr 60px;gap:8px;align-items:center;font-size:11.5px}
.bar-track{height:16px;background:var(--bg);border-radius:4px;overflow:hidden;position:relative;border:1px solid var(--line)}
.bar-fill{height:100%;border-radius:3px;transition:width .3s}
.bar-val{font-family:Consolas,monospace;font-size:11px;text-align:left}

/* ---- data textarea ---- */
textarea#dataBox{width:100%;min-height:400px;font-family:Consolas,monospace;font-size:12px;
  line-height:1.6;padding:12px;border-radius:10px;border:1px solid var(--line-strong);
  background:var(--bg);color:var(--ink);resize:vertical;direction:ltr;text-align:left}
.msg{margin-top:8px;font-size:12.5px;padding:8px 12px;border-radius:9px;display:none}
.msg.ok{display:block;background:#dcfce7;color:#166534;border:1px solid #86efac}
.msg.err{display:block;background:#fee2e2;color:#991b1b;border:1px solid #fca5a5}
[data-theme="dark"] .msg.ok{background:#0d3320;color:#6ee7a8;border-color:#1d6b45}
[data-theme="dark"] .msg.err{background:#3b1212;color:#fca5a5;border-color:#7f1d1d}

/* ---- edge list ---- */
.edge-list{display:grid;gap:5px;max-height:260px;overflow:auto}
.edge-row{display:grid;grid-template-columns:1fr auto;gap:8px;padding:6px 9px;border-radius:7px;
  background:var(--bg);border:1px solid var(--line);font-size:12px;align-items:center}
.edge-row .arrow{color:var(--muted);font-family:Consolas,monospace;margin:0 3px}
.edge-row .sig{font-family:Consolas,monospace;font-weight:700;padding:1px 7px;border-radius:5px;font-size:11px}
.sig.pos{background:#dcfce7;color:#166534}
.sig.neg{background:#fee2e2;color:#991b1b}
[data-theme="dark"] .sig.pos{background:#0d3320;color:#6ee7a8}
[data-theme="dark"] .sig.neg{background:#3b1212;color:#fca5a5}

/* ---- cycle list ---- */
.cycle-list{display:grid;gap:6px;max-height:240px;overflow:auto}
.cycle-row{padding:7px 10px;border-radius:8px;background:var(--bg);border:1px solid var(--line);font-size:11.5px}
.cycle-row .title{font-weight:600;margin-bottom:3px}
.cycle-row.balancing{border-right:3px solid var(--neg)}
.cycle-row.reinforcing{border-right:3px solid var(--pos)}

/* ---- modal ---- */
.modal-backdrop{position:fixed;inset:0;background:rgba(10,16,24,.55);backdrop-filter:blur(3px);
  display:grid;place-items:center;z-index:100;padding:20px}
.modal-backdrop[hidden]{display:none}
.modal{background:var(--panel);border-radius:14px;max-width:880px;width:100%;max-height:88vh;
  display:flex;flex-direction:column;box-shadow:0 24px 60px rgba(0,0,0,.35);border:1px solid var(--line-strong)}
.modal-head{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line)}
.modal-head h3{font-size:14.5px}
.modal-head button{border:0;background:none;font-size:22px;line-height:1;color:var(--muted)}
.modal-body{padding:16px 18px;overflow:auto}
.modal-foot{padding:12px 18px;border-top:1px solid var(--line);display:flex;gap:8px}

/* ---- detail grid ---- */
.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-top:12px}
.metric{background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:8px 10px}
.metric b{display:block;font-family:Consolas,monospace;font-size:15px;color:var(--accent)}
.metric span{font-size:10.5px;color:var(--muted)}
.interpret{margin-top:14px;padding:12px 14px;border-radius:10px;background:var(--accent-soft);
  border:1px solid color-mix(in srgb,var(--accent) 25%,transparent);font-size:13px;line-height:1.9}

/* ---- cluster summary ---- */
.cluster-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;margin-top:12px}
.cluster-card{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.cluster-card h4{font-size:12px;margin-bottom:5px;display:flex;align-items:center;gap:6px}
.cluster-card .dot{width:12px;height:12px;border-radius:50%}
.cluster-card ul{margin:0;padding-inline-start:16px;font-size:12px;color:var(--muted)}
.cluster-card ul li{margin:2px 0}

/* ---- toast ---- */
#toast{position:fixed;bottom:22px;right:50%;transform:translate(50%,20px);opacity:0;
  background:#111827;color:#fff;padding:10px 20px;border-radius:10px;font-size:13px;
  transition:.25s;z-index:200;pointer-events:none;box-shadow:0 10px 30px rgba(0,0,0,.3)}
#toast.show{opacity:1;transform:translate(50%,0)}

@media print{.topbar,.tabs,.toolbar,.panel-box,.modal-foot,footer{display:none!important}
  body{background:#fff}.table-wrap,.heatmap-wrap,.chart-wrap{box-shadow:none;border:0}}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <div class="logo">◈</div>
    <div>
      <h1>میزکار تحلیل ارتباطات و روال‌ها</h1>
      <p>چهار نمای تحلیلی · موتور تحلیل ارتباط · کد و دادهٔ باز (MIT)</p>
    </div>
  </div>
  <div class="top-actions">
    <a href="index.html" style="color:var(--accent);text-decoration:none;font-weight:700;font-size:13px;white-space:nowrap">← مستر پلنر</a>
    <span class="badge">مجوز <b style="color:var(--pos)">MIT</b></span>
    <button class="btn ghost" id="btnTheme">◐ تم</button>
    <button class="btn ghost" id="btnExport">⤓ خروجی JSON</button>
    <button class="btn ghost" id="btnPrint">⎙ چاپ</button>
  </div>
</header>

<nav class="tabs">
  <button class="tab-btn active" data-tab="data">◇ داده</button>
  <button class="tab-btn" data-tab="line">◔ نمودار</button>
  <button class="tab-btn" data-tab="table">▦ جدول</button>
  <button class="tab-btn" data-tab="cycle">◯ چرخهٔ چندعلتی</button>
  <button class="tab-btn" data-tab="cluster">◉ خوشه‌بندی</button>
  <button class="tab-btn" data-tab="analysis">⚙ تحلیل ارتباط</button>
  <button class="tab-btn" data-tab="compare">⇄ مقایسهٔ چندرسمی</button>
</nav>

<main>

<!-- ========== DATA ========== -->
<section class="tab-panel active" id="tab-data">
  <div class="card">
    <h2>ورود داده — سری‌های زمانی و شبکهٔ علّی</h2>
    <p class="muted">داده شامل چند متغیر (گره) با مقادیر هم‌طول، و اختیاری مجموعه‌ای از یال‌های علّی (از → به، علامت +/−، تأخیر). می‌توانید نمونه‌های آماده را بارگذاری کنید یا JSON خود را وارد نمایید.</p>
    <div class="toolbar">
      <button class="btn primary sm" data-sample="study">📘 روال مطالعه (پارادوکس + آستانه)</button>
      <button class="btn sm" data-sample="feedback">🔁 حلقهٔ بازخورد مثبت</button>
      <button class="btn sm" data-sample="balance">⚖ سیستم متعادل (نوسانی)</button>
      <button class="btn sm" data-sample="random">🎲 داده تصادفی</button>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:12px 0">
      <button class="btn primary sm" id="btnApplyData">ذخیره و تحلیل</button>
      <button class="btn sm" id="btnValidateData">اعتبارسنجی</button>
      <button class="btn sm ghost" id="btnReloadData">بازخوانی از حافظه</button>
    </div>
    <textarea id="dataBox" spellcheck="false"></textarea>
    <div class="msg" id="dataMsg"></div>
  </div>
</section>

<!-- ========== LINE CHART ========== -->
<section class="tab-panel" id="tab-line">
  <div class="card">
    <h2>نمودار خطی سری‌های زمانی</h2>
    <p class="muted">برای پنهان/نمایش هر سری روی برچسب آن کلیک کنید. بیشینه و کمینهٔ هر سری با نشانگر مشخص شده است.</p>
    <div class="chart-wrap"><svg id="lineChart" viewBox="0 0 980 460"></svg></div>
    <div class="legend" id="lineLegend"></div>
  </div>
  <div class="card" id="lineStatsCard">
    <h3>خلاصهٔ آماری هر سری</h3>
    <div class="table-wrap" style="max-height:none">
      <table class="grid"><thead><tr>
        <th>متغیر</th><th>میانگین</th><th>انحراف معیار</th><th>کمینه (گام)</th><th>بیشینه (گام)</th><th>دامنه</th>
      </tr></thead><tbody id="lineStatsBody"></tbody></table>
    </div>
  </div>
</section>

<!-- ========== TABLE ========== -->
<section class="tab-panel" id="tab-table">
  <div class="card">
    <h2>جدول داده و ماتریس همبستگی</h2>
    <div class="toolbar">
      <select class="filter" id="tableMode">
        <option value="raw">دادهٔ خام</option>
        <option value="corr" selected>ماتریس همبستگی (پیرسون)</option>
        <option value="spearman">ماتریس همبستگی (اسپیرمن)</option>
      </select>
    </div>
    <div class="table-wrap" id="tableWrap"></div>
  </div>
</section>

<!-- ========== CYCLE ========== -->
<section class="tab-panel" id="tab-cycle">
  <div class="split-3">
    <div class="chart-wrap"><svg id="cycleChart" viewBox="0 0 640 640"></svg></div>
    <div class="panel-box">
