function miniScatter(p){
  const A = computed.nodes.find(n=>n.id===p.a);
  const B = computed.nodes.find(n=>n.id===p.b);
  const x = A.values, y = B.values;
  const W = 320, H = 250;
  const P = {l:44, r:14, t:16, b:36};
  const xMin = Math.min(...x), xMax = Math.max(...x);
  const yMin = Math.min(...y), yMax = Math.max(...y);
  const padX = (xMax-xMin)*0.06 || 1, padY = (yMax-yMin)*0.06 || 1;
  const x0 = xMin-padX, x1 = xMax+padX, y0 = yMin-padY, y1 = yMax+padY;
  const xS = v => P.l + (v-x0)/(x1-x0) * (W-P.l-P.r);
  const yS = v => H-P.b - (v-y0)/(y1-y0) * (H-P.t-P.b);

  const parts = [];
  if(p.thr && p.thr.gain > 0.12){
    const tx = xS(p.thr.threshold);
    parts.push(`<line x1="${tx}" y1="${P.t}" x2="${tx}" y2="${H-P.b}" stroke="var(--amber)" stroke-width="1.5" stroke-dasharray="4 3" opacity=".8"/>`);
  }
  x.forEach((xi,i)=>{
    if(!isFinite(xi)||!isFinite(y[i])) return;
    parts.push(`<circle cx="${xS(xi)}" cy="${yS(y[i])}" r="3.6" fill="var(--accent)" opacity=".7"/>`);
  });
  if(!isNaN(p.lin.slope)){
    parts.push(`<line x1="${xS(x0)}" y1="${yS(p.lin.slope*x0+p.lin.intercept)}" x2="${xS(x1)}" y2="${yS(p.lin.slope*x1+p.lin.intercept)}" stroke="var(--accent)" stroke-width="2"/>`);
  }
  if(p.quad.coef){
    const [a,b,c] = p.quad.coef;
    let d = '';
    for(let t=0;t<=40;t++){
      const xv = x0 + (x1-x0)*t/40;
      const yv = a + b*xv + c*xv*xv;
      d += (t?'L':'M') + xS(xv) + ',' + yS(yv) + ' ';
    }
    parts.push(`<path d="${d}" fill="none" stroke="var(--purple)" stroke-width="1.8" stroke-dasharray="5 4"/>`);
  }
  parts.push(`<line x1="${P.l}" y1="${H-P.b}" x2="${W-P.r}" y2="${H-P.b}" stroke="var(--line-strong)"/>`);
  parts.push(`<line x1="${P.l}" y1="${P.t}" x2="${P.l}" y2="${H-P.b}" stroke="var(--line-strong)"/>`);
  parts.push(`<text x="${(P.l+W-P.r)/2}" y="${H-8}" class="axis-label" text-anchor="middle">${A.name}</text>`);
  parts.push(`<text x="12" y="${(P.t+H-P.b)/2}" class="axis-label" text-anchor="middle" transform="rotate(-90 12 ${(P.t+H-P.b)/2})">${B.name}</text>`);

  const tags = classifyPair(p);
  return `<div class="mini-card">
    <h4>${A.name} ↔ ${B.name}</h4>
    <svg viewBox="0 0 ${W} ${H}">${parts.join('')}</svg>
    <div class="stats">
      <span>r <b>${fmt(p.r)}</b></span>
      <span>ρ <b>${fmt(p.rho)}</b></span>
      <span>R²<sub>lin</sub> <b>${fmt(p.lin.r2)}</b></span>
      <span>R²<sub>quad</sub> <b>${fmt(p.quad.r2)}</b></span>
    </div>
    <div style="margin-top:5px">${tags.map(t=>`<span class="chip ${t.c}">${t.t}</span>`).join('')}</div>
  </div>`;
}

/* =========================================================
   ۱۴) جزئیات جفت (مودال)
   ========================================================= */
function openPairDetail(key){
  const [a,b] = key.split('|');
  const p = computed.pairs.find(x => (x.a===a && x.b===b) || (x.a===b && x.b===a));
  if(!p) return;
  S.activePair = p;

  const A = computed.nodes.find(n=>n.id===p.a);
  const B = computed.nodes.find(n=>n.id===p.b);

  const bestLag = p.lag.reduce((best,l)=> (!best || Math.abs(l.r)>Math.abs(best.r)) ? l : best, null);
  const gainQ = p.quad.r2 - p.lin.r2;
  const tags = classifyPair(p);

  $('#modalTitle').textContent = `${A.name} ↔ ${B.name}`;
  $('#modalBody').innerHTML = `
    <div style="display:flex;justify-content:center">${miniScatterBig(p)}</div>
    <div class="metrics-grid">
      <div class="metric"><b>${fmt(p.r)}</b><span>پیرسون (r)</span></div>
      <div class="metric"><b>${fmt(p.rho)}</b><span>اسپیرمن (ρ)</span></div>
      <div class="metric"><b>${fmt(p.lin.r2)}</b><span>R² خطی</span></div>
      <div class="metric"><b>${fmt(p.quad.r2)}</b><span>R² درجه ۲</span></div>
      <div class="metric"><b>${gainQ>0?'+':''}${fmt(gainQ)}</b><span>سود غیرخطی</span></div>
      <div class="metric"><b>${p.thr ? fmt(p.thr.threshold) : '—'}</b><span>آستانه (x)</span></div>
      <div class="metric"><b>${p.half.flip ? 'بله' : 'خیر'}</b><span>تغییر رژیم</span></div>
      <div class="metric"><b>${bestLag ? (bestLag.lag>0?'+':'')+fa(bestLag.lag,0) : '—'}</b><span>تأخیر بهینه</span></div>
    </div>
    <div style="margin-top:10px">${tags.map(t=>`<span class="chip ${t.c}">${t.t}</span>`).join('')}</div>
    <div class="interpret">${interpretPair(p)}</div>
  `;
  $('#modal').hidden = false;
}

function miniScatterBig(p){
  const A = computed.nodes.find(n=>n.id===p.a);
  const B = computed.nodes.find(n=>n.id===p.b);
  const x = A.values, y = B.values;
  const W = 760, H = 360;
  const P = {l:56, r:20, t:20, b:44};
  const xMin = Math.min(...x), xMax = Math.max(...x);
  const yMin = Math.min(...y), yMax = Math.max(...y);
  const padX = (xMax-xMin)*0.06||1, padY = (yMax-yMin)*0.06||1;
  const x0=xMin-padX, x1=xMax+padX, y0=yMin-padY, y1=yMax+padY;
  const xS = v => P.l + (v-x0)/(x1-x0)*(W-P.l-P.r);
  const yS = v => H-P.b - (v-y0)/(y1-y0)*(H-P.t-P.b);

  const parts = [];
  if(p.thr && p.thr.gain > 0.12){
    parts.push(`<line x1="${xS(p.thr.threshold)}" y1="${P.t}" x2="${xS(p.thr.threshold)}" y2="${H-P.b}" stroke="var(--amber)" stroke-width="1.8" stroke-dasharray="5 4"/>`);
    parts.push(`<text x="${xS(p.thr.threshold)+4}" y="${P.t+12}" class="axis-label" style="fill:var(--amber)">آستانه ${fmt(p.thr.threshold)}</text>`);
  }
  x.forEach((xi,i)=>{
    if(!isFinite(xi)||!isFinite(y[i])) return;
    parts.push(`<circle cx="${xS(xi)}" cy="${yS(y[i])}" r="5" fill="var(--accent)" opacity=".75"/>`);
  });
  if(!isNaN(p.lin.slope)){
    parts.push(`<line x1="${xS(x0)}" y1="${yS(p.lin.slope*x0+p.lin.intercept)}" x2="${xS(x1)}" y2="${yS(p.lin.slope*x1+p.lin.intercept)}" stroke="var(--accent)" stroke-width="2.2"/>`);
  }
  if(p.quad.coef){
    const [a,b,c] = p.quad.coef;
    let d = '';
    for(let t=0;t<=60;t++){
      const xv = x0+(x1-x0)*t/60;
      d += (t?'L':'M') + xS(xv) + ',' + yS(a+b*xv+c*xv*xv) + ' ';
    }
    parts.push(`<path d="${d}" fill="none" stroke="var(--purple)" stroke-width="2" stroke-dasharray="6 4"/>`);
  }
  parts.push(`<line x1="${P.l}" y1="${H-P.b}" x2="${W-P.r}" y2="${H-P.b}" stroke="var(--line-strong)"/>`);
  parts.push(`<line x1="${P.l}" y1="${P.t}" x2="${P.l}" y2="${H-P.b}" stroke="var(--line-strong)"/>`);
  parts.push(`<text x="${(P.l+W-P.r)/2}" y="${H-10}" class="axis-label" text-anchor="middle">${A.name}</text>`);
  parts.push(`<text x="14" y="${(P.t+H-P.b)/2}" class="axis-label" text-anchor="middle" transform="rotate(-90 14 ${(P.t+H-P.b)/2})">${B.name}</text>`);
  return `<svg viewBox="0 0 ${W} ${H}" style="max-width:100%;height:auto">${parts.join('')}</svg>`;
}

function interpretPair(p){
  const A = computed.nodes.find(n=>n.id===p.a);
  const B = computed.nodes.find(n=>n.id===p.b);
  const r = p.r;
  if(isNaN(r)) return 'داده کافی برای تفسیر نیست.';

  let s = '';
  const absR = Math.abs(r);
  if(absR >= 0.7) s += `همبستگی ${r>0?'مستقیم':'معکوس'} قوی (r = ${fmt(r)}) بین «${A.name}» و «${B.name}» وجود دارد. `;
  else if(absR >= 0.4) s += `همبستگی ${r>0?'مستقیم':'معکوس'} متوسط (r = ${fmt(r)}) بین «${A.name}» و «${B.name}» دیده می‌شود. `;
  else if(absR >= 0.2) s += `همبستگی ${r>0?'مستقیم':'معکوس'} ضعیف (r = ${fmt(r)}) بین «${A.name}» و «${B.name}» وجود دارد. `;
  else s += `همبستگی خطی معناداری (r = ${fmt(r)}) بین «${A.name}» و «${B.name}» دیده نمی‌شود. `;

  const gainQ = p.quad.r2 - p.lin.r2;
  if(gainQ > 0.12) s += `مدل درجه دو ${(gainQ*100).toFixed(0)}٪ واریانس بیشتری توضیح می‌دهد؛ یعنی رابطه غیرخطی است. `;

  if(p.thr && p.thr.gain > 0.12){
    s += `آستانه‌ای نزدیک «${A.name} = ${fmt(p.thr.threshold)}» دیده می‌شود: شیب قبل ${fmt(p.thr.slope1)} و بعد ${fmt(p.thr.slope2)}. `;
    if(p.thr.signFlip) s += `علامت شیب عوض شده — این یک کرانهٔ رفتاری است. `;
  }

  if(p.half.flip){
    s += `نیمهٔ اول و دوم داده علامت همبستگی متفاوتی دارند (${fmt(p.half.r1)} در برابر ${fmt(p.half.r2)}). این یک متناقض‌نماست: روند کلی می‌تواند گمراه‌کننده باشد. `;
  }

  if(p.edge){
    const declared = p.edge.sign > 0 ? 'مستقیم (+)' : 'معکوس (−)';
    const observed = r > 0 ? 'مستقیم (+)' : 'معکوس (−)';
    if(p.edge.sign !== Math.sign(r) && Math.abs(r) > 0.15){
      s += `فرض علّی ثبت‌شده «${declared}» است اما همبستگی مشاهده‌شده «${observed}» است — احتمالاً یک متغیر میانجی یا مخدوش‌کننده در کار است. `;
    } else {
      s += `همبستگی مشاهده‌شده با فرض علّی ثبت‌شده هم‌راستاست. `;
    }
  }

  const bestLag = p.lag.reduce((b,l)=> (!b || Math.abs(l.r)>Math.abs(b.r)) ? l : b, null);
  if(bestLag && bestLag.lag !== 0 && Math.abs(bestLag.r) > Math.abs(r) + 0.05){
    s += `قوی‌ترین همبستگی در تأخیر ${bestLag.lag > 0 ? '+' : ''}${bestLag.lag} است (r = ${fmt(bestLag.r)})؛ این سرنخی از جهت علّی است، نه اثبات آن. `;
  }

  return s;
}

/* =========================================================
   ۱۵) رویدادها
   ========================================================= */
let toastTimer;
function toast(msg){
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> t.classList.remove('show'), 2200);
}

function setTheme(t){
  S.theme = t;
  document.documentElement.dataset.theme = t;
  save();
  if(computed){ renderTable(); renderCluster(); renderCompare(); }
}

function switchTab(name){
  $$('.tab-btn').forEach(b=> b.classList.toggle('active', b.dataset.tab===name));
  $$('.tab-panel').forEach(p=> p.classList.toggle('active', p.id==='tab-'+name));
  if(name==='data') fillDataBox();
}

function refreshAll(){
  analyze();
  renderLine();
  renderLineStats();
  renderTable();
  renderCycle();
  renderCluster();
  renderAnalysis();
  renderCompare();
  populateComparePicker();
}

function fillDataBox(){
  if(DATA) $('#dataBox').value = JSON.stringify(DATA, null, 2);
}

function dataMsg(text, ok){
  const el = $('#dataMsg');
  el.className = 'msg ' + (ok?'ok':'err');
  el.textContent = text;
}

function loadData(obj){
  const v = validate(obj);
  if(!v.ok){ dataMsg(v.err, false); return false; }
  DATA = obj;
  S.visible = new Set(DATA.nodes.map(n=>n.id));
  S.selectedPairs = [];
  save();
  refreshAll();
  return true;
}

function populateComparePicker(){
  const sel = $('#comparePicker');
  if(!computed){ sel.innerHTML = ''; return; }
  sel.innerHTML = computed.pairs.map(p=>{
    const A = computed.nodes.find(n=>n.id===p.a).name;
    const B = computed.nodes.find(n=>n.id===p.b).name;
    const key = p.a+'|'+p.b;
    return `<option value="${key}">${A} ↔ ${B}  (r=${fmt(p.r)})</option>`;
  }).join('');
}

function downloadFile(name, content, type){
  const blob = new Blob([content], {type: type+';charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=> URL.revokeObjectURL(a.href), 2000);
}

/* =========================================================
   ۱۶) اتصال رویدادها
   ========================================================= */
function bind(){
  $$('.tab-btn').forEach(b=> b.addEventListener('click', ()=> switchTab(b.dataset.tab)));
  $('#btnTheme').addEventListener('click', ()=> setTheme(S.theme==='dark'?'light':'dark'));
  $('#btnPrint').addEventListener('click', ()=> window.print());
  $('#btnExport').addEventListener('click', ()=>{
    if(!DATA) return;
    const payload = {data:DATA, computed:{
      pairs: computed.pairs.map(p=>({
        a:p.a, b:p.b, r:p.r, rho:p.rho, r2lin:p.lin.r2, r2quad:p.quad.r2,
        threshold:p.thr, halfSplit:p.half, tags:classifyPair(p).map(t=>t.t)
      })),
      cycles: computed.cycles
    }};
    downloadFile('relational-analysis.json', JSON.stringify(payload, null, 2), 'application/json');
  });

  $$('[data-sample]').forEach(b=> b.addEventListener('click', ()=>{
    const key = b.dataset.sample;
    const obj = key==='random' ? randomData() : JSON.parse(JSON.stringify(SAMPLES[key]));
    if(loadData(obj)){
      fillDataBox();
      dataMsg(`نمونه «${obj.title}» بارگذاری شد.`, true);
      toast('داده بارگذاری شد');
    }
  }));

  $('#btnApplyData').addEventListener('click', ()=>{
    try{
      const obj = JSON.parse($('#dataBox').value);
      if(loadData(obj)){
        dataMsg('داده ذخیره و تحلیل شد.', true);
        toast('تحلیل به‌روزرسانی شد');
      }
    }catch(e){ dataMsg('خطای JSON: '+e.message, false); }
  });
  $('#btnValidateData').addEventListener('click', ()=>{
    try{
      const obj = JSON.parse($('#dataBox').value);
      const v = validate(obj);
      dataMsg(v.ok ? `داده معتبر است: ${obj.nodes.length} متغیر، ${obj.edges?.length||0} یال.` : v.err, v.ok);
    }catch(e){ dataMsg('خطای JSON: '+e.message, false); }
  });
  $('#btnReloadData').addEventListener('click', ()=>{ fillDataBox(); dataMsg('متن از حافظهٔ فعلی بازخوانی شد.', true); });

  $('#lineLegend').addEventListener('click', e=>{
    const item = e.target.closest('[data-toggle]');
    if(!item) return;
    const id = item.dataset.toggle;
    if(S.visible.has(id)) S.visible.delete(id); else S.visible.add(id);
    save();
    renderLine();
  });

  $('#tableMode').addEventListener('change', e=>{ S.tableMode = e.target.value; save(); renderTable(); });

  const slider = $('#clusterThreshold');
  slider.value = S.clusterThreshold;
  $('#clusterThresholdLabel').textContent = `r > ${fmt(S.clusterThreshold)}`;
  slider.addEventListener('input', e=>{
    S.clusterThreshold = +e.target.value;
    $('#clusterThresholdLabel').textContent = `r > ${fmt(S.clusterThreshold)}`;
    if(computed){
      computed.clusters = cluster(computed.nodes, computed.corr, S.clusterThreshold);
      renderCluster();
    }
    save();
  });

  $('#analysisSearch').addEventListener('input', renderAnalysis);
  $('#analysisSort').addEventListener('change', renderAnalysis);
  $('#analysisFilter').addEventListener('change', renderAnalysis);

  $('#analysisBody').addEventListener('click', e=>{
    const btn = e.target.closest('[data-detail]');
    if(!btn) return;
    openPairDetail(btn.dataset.detail);
  });
  $('#analysisBody').addEventListener('dblclick', e=>{
    const tr = e.target.closest('tr[data-pair]');
    if(!tr) return;
    openPairDetail(tr.dataset.pair);
  });

  $('#modalClose').addEventListener('click', ()=> $('#modal').hidden = true);
  $('#modalClose2').addEventListener('click', ()=> $('#modal').hidden = true);
  $('#modal').addEventListener('click', e=>{ if(e.target.id==='modal') $('#modal').hidden = true; });
  $('#modalAddCompare').addEventListener('click', ()=>{
    if(!S.activePair) return;
    const key = S.activePair.a+'|'+S.activePair.b;
    if(!S.selectedPairs.includes(key)) S.selectedPairs.push(key);
    save(); renderCompare();
    $('#modal').hidden = true;
    toast('به مقایسه افزوده شد');
    switchTab('compare');
  });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') $('#modal').hidden = true; });

  $('#btnAddCompare').addEventListener('click', ()=>{
    const key = $('#comparePicker').value;
    if(!key) return;
    if(!S.selectedPairs.includes(key)) S.selectedPairs.push(key);
    save(); renderCompare();
  });
  $('#btnAddTop').addEventListener('click', ()=>{
    if(!computed) return;
    const top = computed.pairs.slice().sort((a,b)=> Math.abs(b.r)-Math.abs(a.r)).slice(0,4);
    top.forEach(p=>{
      const key = p.a+'|'+p.b;
      if(!S.selectedPairs.includes(key)) S.selectedPairs.push(key);
    });
    save(); renderCompare();
    toast('چهار جفت برتر افزوده شد');
  });
  $('#btnClearCompare').addEventListener('click', ()=>{ S.selectedPairs = []; save(); renderCompare(); });
}

/* =========================================================
   ۱۷) راه‌اندازی
   ========================================================= */
(function init(){
  if(!load()){
    DATA = JSON.parse(JSON.stringify(SAMPLES.study));
    S.visible = new Set(DATA.nodes.map(n=>n.id));
  }
  if(!S.visible.size){
    S.visible = new Set(DATA.nodes.map(n=>n.id));
  }
  document.documentElement.dataset.theme = S.theme || 'dark';
  bind();
  refreshAll();
  fillDataBox();
})();
</script>
</body>
