<script>
/* =========================================================
   ۱) ابزارهای پایه
   ========================================================= */
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const fa = (v,d=2) => isNaN(v) ? '—' : Number(v).toLocaleString('fa-IR',{maximumFractionDigits:d});
const fmt = (v,d=2) => isNaN(v) ? '—' : Number(v).toFixed(d);
const PALETTE = ['#2563eb','#dc2626','#059669','#d97706','#7c3aed','#0891b2','#db2777','#65a30d','#c026d3','#0284c7','#ea580c','#16a34a'];

/* =========================================================
   ۲) موتور ریاضی
   ========================================================= */
const M = {
  mean: a => a.reduce((s,v)=>s+v,0)/a.length,
  stdev: a => { const m=M.mean(a); return Math.sqrt(a.reduce((s,v)=>s+(v-m)**2,0)/(a.length-1)); },
  pearson: (x,y) => {
    const n = Math.min(x.length,y.length);
    const mx = M.mean(x.slice(0,n)), my = M.mean(y.slice(0,n));
    let sxy=0,sxx=0,syy=0;
    for(let i=0;i<n;i++){
      if(!isFinite(x[i])||!isFinite(y[i])) continue;
      const dx=x[i]-mx, dy=y[i]-my; sxy+=dx*dy; sxx+=dx*dx; syy+=dy*dy;
    }
    if(sxx===0||syy===0) return NaN;
    return sxy/Math.sqrt(sxx*syy);
  },
  rank: a => {
    const idx = a.map((v,i)=>[v,i]).sort((p,q)=>p[0]-q[0]);
    const r = new Array(a.length);
    let i=0;
    while(i<idx.length){
      let j=i;
      while(j+1<idx.length && idx[j+1][0]===idx[i][0]) j++;
      const avg = (i+j)/2 + 1;
      for(let k=i;k<=j;k++) r[idx[k][1]] = avg;
      i = j+1;
    }
    return r;
  },
  spearman: (x,y) => M.pearson(M.rank(x),M.rank(y)),
  linreg: (x,y) => {
    const n = Math.min(x.length,y.length);
    const mx = M.mean(x.slice(0,n)), my = M.mean(y.slice(0,n));
    let sxy=0,sxx=0,sst=0;
    for(let i=0;i<n;i++){ if(!isFinite(x[i])||!isFinite(y[i])) continue; sxy+=(x[i]-mx)*(y[i]-my); sxx+=(x[i]-mx)**2; sst+=(y[i]-my)**2; }
    if(sxx===0) return {slope:NaN,intercept:NaN,r2:NaN,sse:NaN,sst:NaN};
    const slope = sxy/sxx, intercept = my - slope*mx;
    let sse=0; for(let i=0;i<n;i++){ if(!isFinite(x[i])||!isFinite(y[i])) continue; sse += (y[i]-(slope*x[i]+intercept))**2; }
    const r2 = sst===0 ? NaN : 1 - sse/sst;
    return {slope,intercept,r2,sse,sst};
  },
  solve3: (A,b) => {
    const Mx = A.map((r,i)=>[...r,b[i]]);
    for(let i=0;i<3;i++){
      let p=i; for(let r=i+1;r<3;r++) if(Math.abs(Mx[r][i])>Math.abs(Mx[p][i])) p=r;
      if(Math.abs(Mx[p][i])<1e-12) return null;
      [Mx[i],Mx[p]]=[Mx[p],Mx[i]];
      for(let r=i+1;r<3;r++){ const f=Mx[r][i]/Mx[i][i]; for(let c=i;c<4;c++) Mx[r][c]-=f*Mx[i][c]; }
    }
    const x=[0,0,0];
    for(let i=2;i>=0;i--){ let s=Mx[i][3]; for(let c=i+1;c<3;c++) s-=Mx[i][c]*x[c]; x[i]=s/Mx[i][i]; }
    return x;
  },
  quadreg: (x,y) => {
    const n = Math.min(x.length,y.length);
    let s1=0,s2=0,s3=0,s4=0,sy=0,sxy=0,sx2y=0;
    for(let i=0;i<n;i++){
      if(!isFinite(x[i])||!isFinite(y[i])) continue;
      const xi=x[i], yi=y[i], x2=xi*xi;
      s1+=xi; s2+=x2; s3+=x2*xi; s4+=x2*x2;
      sy+=yi; sxy+=xi*yi; sx2y+=x2*yi;
    }
    const A = [[n,s1,s2],[s1,s2,s3],[s2,s3,s4]], b = [sy,sxy,sx2y];
    const sol = M.solve3(A,b);
    const my = M.mean(y.slice(0,n));
    let sst=0; for(let i=0;i<n;i++){ if(!isFinite(y[i])) continue; sst += (y[i]-my)**2; }
    if(!sol) return {r2:NaN,coef:null,sst};
    const [a,bq,c] = sol;
    let sse=0;
    for(let i=0;i<n;i++){ if(!isFinite(x[i])||!isFinite(y[i])) continue; sse += (y[i]-(a+bq*x[i]+c*x[i]*x[i]))**2; }
    const r2 = sst===0 ? NaN : 1 - sse/sst;
    return {r2,coef:sol,sse,sst};
  },
  halfSplit: (x,y) => {
    const n = Math.min(x.length,y.length), h = Math.floor(n/2);
    const r1 = M.pearson(x.slice(0,h), y.slice(0,h));
    const r2 = M.pearson(x.slice(h), y.slice(h));
    return {r1, r2, flip: !isNaN(r1) && !isNaN(r2) && (r1>0)!==(r2>0) && Math.abs(r1)>0.1 && Math.abs(r2)>0.1};
  },
  xThreshold: (x,y) => {
    const n = Math.min(x.length,y.length);
    if(n < 6) return null;
    const idx = x.map((_,i)=>i).sort((a,b)=>x[a]-x[b]);
    const xs = idx.map(i=>x[i]), ys = idx.map(i=>y[i]);
    const lin = M.linreg(xs,ys);
    if(isNaN(lin.sst) || lin.sst===0) return null;
    let best = null;
    for(let k=2; k<=n-3; k++){
      const r1 = M.linreg(xs.slice(0,k), ys.slice(0,k));
      const r2 = M.linreg(xs.slice(k), ys.slice(k));
      if(isNaN(r1.sse) || isNaN(r2.sse)) continue;
      const sse = r1.sse + r2.sse;
      const r2v = 1 - sse/lin.sst;
      if(!best || r2v > best.r2){
        best = {k, r2:r2v, slope1:r1.slope, slope2:r2.slope, threshold:xs[k]};
      }
    }
    if(!best) return null;
    return {...best, linR2:lin.r2, gain: best.r2 - lin.r2,
      signFlip: Math.abs(best.slope1)>1e-9 && Math.abs(best.slope2)>1e-9 && (best.slope1>0)!==(best.slope2>0)};
  },
  lagCorr: (x,y,maxLag=3) => {
    const n = Math.min(x.length,y.length), out = [];
    for(let L=-maxLag; L<=maxLag; L++){
      const xs=[], ys=[];
      for(let t=0;t<n;t++){
        const j = t+L;
        if(j<0||j>=n) continue;
        if(!isFinite(x[t])||!isFinite(y[j])) continue;
        xs.push(x[t]); ys.push(y[j]);
      }
      if(xs.length < 4) continue;
      out.push({lag:L, r:M.pearson(xs,ys), n:xs.length});
    }
    return out;
  }
};

