/* =========================================================
   ۱۰) رندر چرخه
   ========================================================= */
function renderCycle(){
  const svg = $('#cycleChart');
  const edgeList = $('#edgeList');
  const cycleList = $('#cycleList');
  if(!computed){ svg.innerHTML=''; edgeList.innerHTML=''; cycleList.innerHTML=''; return; }

  const nodes = computed.nodes;
  const edges = computed.edges;
  const n = nodes.length;

  const W = 640, H = 640;
  const cx = W/2, cy = H/2, R = Math.min(W,H)/2 - 80;

  const pos = {};
  nodes.forEach((nd,i)=>{
    const ang = -Math.PI/2 + i*2*Math.PI/n;
    pos[nd.id] = {x: cx + R*Math.cos(ang), y: cy + R*Math.sin(ang)};
  });

  const pairCount = {};
  edges.forEach(e=>{
    const key = [e.from,e.to].sort().join('|');
    pairCount[key] = (pairCount[key]||0)+1;
  });

  const parts = [];
  parts.push(`<defs>
    <marker id="arrow-pos" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--pos)"/></marker>
    <marker id="arrow-neg" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--neg)"/></marker>
  </defs>`);

  edges.forEach(e=>{
    const A = pos[e.from], B = pos[e.to];
    if(!A || !B) return;
    const key = [e.from,e.to].sort().join('|');
    const bi = (pairCount[key]||0) > 1;

    const mx = (A.x+B.x)/2, my = (A.y+B.y)/2;
    const dx = mx-cx, dy = my-cy, len = Math.hypot(dx,dy)||1;
    const off = bi ? 34 : 20;
    const sign = e.from < e.to ? 1 : -1;
    const qx = mx + (-dy/len)*off*sign;
    const qy = my + (dx/len)*off*sign;

    const nodeR = 24;
    const dAB = Math.hypot(B.x-A.x, B.y-A.y) || 1;
    const ux = (B.x-A.x)/dAB, uy = (B.y-A.y)/dAB;
    const ax = A.x + ux*nodeR, ay = A.y + uy*nodeR;
    const bx = B.x - ux*nodeR, by = B.y - uy*nodeR;

    const color = e.sign > 0 ? 'var(--pos)' : 'var(--neg)';
    const dash = (e.lag||0) > 0 ? 'stroke-dasharray="6 4"' : '';
    const marker = e.sign > 0 ? 'arrow-pos' : 'arrow-neg';

    parts.push(`<path d="M${ax},${ay} Q${qx},${qy} ${bx},${by}" fill="none" stroke="${color}" stroke-width="2" marker-end="url(#${marker})" ${dash}/>`);

    const lx = ((ax+bx)/2)*0.35 + qx*0.65;
    const ly = ((ay+by)/2)*0.35 + qy*0.65;
    const lbl = (e.sign>0?'+':'−') + ((e.lag||0) ? ' t+' + fa(e.lag,0) : '');
    parts.push(`<text x="${lx}" y="${ly}" class="edge-label">${lbl}</text>`);
  });

  nodes.forEach((nd,i)=>{
    const p = pos[nd.id];
    const color = PALETTE[i%PALETTE.length];
    parts.push(`<circle cx="${p.x}" cy="${p.y}" r="24" fill="${color}" stroke="var(--panel)" stroke-width="3"/>`);
    parts.push(`<text x="${p.x}" y="${p.y+4}" class="node-label" style="fill:#fff;font-size:11px" text-anchor="middle">${fa(i+1,0)}</text>`);
    parts.push(`<text x="${p.x}" y="${p.y+38}" class="node-label">${nd.name}</text>`);
  });

  svg.innerHTML = parts.join('');

  const edgeHtml = edges.length ? edges.map(e=>{
    const A = nodes.find(x=>x.id===e.from), B = nodes.find(x=>x.id===e.to);
    const p = computed.pairs.find(pp => (pp.a===e.from && pp.b===e.to) || (pp.a===e.to && pp.b===e.from));
    const obs = p ? p.r : NaN;
    const consistent = !isNaN(obs) && Math.sign(obs) === e.sign;
    return `<div class="edge-row">
      <div>${A.name} <span class="arrow">→</span> ${B.name} ${e.lag?`<span class="muted" style="font-size:10px">(تأخیر ${fa(e.lag,0)})</span>`:''}</div>
      <div><span class="sig ${e.sign>0?'pos':'neg'}">${e.sign>0?'+':'−'} · مشاهده ${fmt(obs)}</span>
      ${!isNaN(obs) && !consistent ? '<span class="chip par" style="margin-right:4px">مغایر</span>' : ''}</div>
    </div>`;
  }).join('') : '<div class="muted" style="text-align:center;padding:14px">یال علّی ثبت نشده. از تب «داده» می‌توانید اضافه کنید.</div>';
  edgeList.innerHTML = edgeHtml;
  $('#edgeCount').textContent = fa(edges.length);

  if(!computed.cycles.length){
    cycleList.innerHTML = '<div class="muted" style="text-align:center;padding:14px">حلقه‌ای شناسایی نشد.</div>';
  } else {
    cycleList.innerHTML = computed.cycles.map(c=>{
      const names = c.nodes.map(id => nodes.find(n=>n.id===id)?.name || id).join(' → ');
      const typeLabel = c.type==='reinforcing' ? 'تقویت‌کننده (واگرا)' : 'متعادل‌کننده (همگرا)';
      return `<div class="cycle-row ${c.type}">
        <div class="title">${typeLabel}</div>
        <div>${names} → ${nodes.find(n=>n.id===c.nodes[0])?.name}</div>
        <div class="muted" style="font-size:10.5px;margin-top:3px">علامت‌ها: ${c.signs.map(s=>s>0?'+':'−').join(' ')} · تأخیر کل: ${fa(c.totalLag,0)}</div>
      </div>`;
    }).join('');
  }
}

