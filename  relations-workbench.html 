/* =========================================================
   ۱۲) رندر تحلیل
   ========================================================= */
function renderAnalysis(){
  const body = $('#analysisBody');
  if(!computed){ body.innerHTML = ''; return; }

  const q = ($('#analysisSearch').value || '').trim().toLowerCase();
  const sortBy = $('#analysisSort').value;
  const filterBy = $('#analysisFilter').value;

  let pairs = computed.pairs.slice();

  if(q){
    pairs = pairs.filter(p=>{
      const A = computed.nodes.find(n=>n.id===p.a).name;
      const B = computed.nodes.find(n=>n.id===p.b).name;
      return (A+B).toLowerCase().includes(q) || classifyPair(p).some(t=>t.t.includes(q));
    });
  }

  if(filterBy === 'paradox') pairs = pairs.filter(p => p.half.flip || (p.edge && Math.sign(p.r)!==p.edge.sign));
  if(filterBy === 'nonlinear') pairs = pairs.filter(p => (p.quad.r2 - p.lin.r2) > 0.12);
  if(filterBy === 'threshold') pairs = pairs.filter(p => p.thr && p.thr.gain > 0.12);
  if(filterBy === 'causal') pairs = pairs.filter(p => p.edge);

  const sorters = {
    absR: (a,b)=> Math.abs(b.r)-Math.abs(a.r),
    r: (a,b)=> b.r-a.r,
    name: (a,b)=> {
      const an = computed.nodes.find(n=>n.id===a.a).name + computed.nodes.find(n=>n.id===a.b).name;
      const bn = computed.nodes.find(n=>n.id===b.a).name + computed.nodes.find(n=>n.id===b.b).name;
      return an.localeCompare(bn,'fa');
    },
    gain: (a,b)=> (b.quad.r2-b.lin.r2)-(a.quad.r2-a.lin.r2),
    thr: (a,b)=> ((b.thr?.gain||0)-(a.thr?.gain||0))
  };
  pairs.sort(sorters[sortBy] || sorters.absR);

  if(!pairs.length){
    body.innerHTML = '<tr><td colspan="9"><div class="muted" style="text-align:center;padding:18px">جفتی با این فیلتر پیدا نشد.</div></td></tr>';
    return;
  }

  body.innerHTML = pairs.map((p,i)=>{
    const A = computed.nodes.find(n=>n.id===p.a).name;
    const B = computed.nodes.find(n=>n.id===p.b).name;
    const tags = classifyPair(p);
    const gainQ = p.quad.r2 - p.lin.r2;
    return `<tr data-pair="${p.a}|${p.b}">
      <td class="num">${fa(i+1,0)}</td>
      <td>${A} <span class="muted">↔</span> ${B}</td>
      <td class="num" style="font-weight:700;color:${p.r>0?'var(--pos)':'var(--neg)'}">${fmt(p.r)}</td>
      <td class="num">${fmt(p.rho)}</td>
      <td class="num">${fmt(p.lin.r2)}</td>
      <td class="num">${fmt(p.quad.r2)}</td>
      <td class="num" style="color:${gainQ>0.12?'var(--purple)':'var(--muted)'}">${gainQ>0?'+':''}${fmt(gainQ)}</td>
      <td>${tags.map(t=>`<span class="chip ${t.c}">${t.t}</span>`).join('')}</td>
      <td><button class="btn sm ghost" data-detail="${p.a}|${p.b}">جزئیات</button></td>
    </tr>`;
  }).join('');
}

